# Government National Security Economic Risk Dashboard
# Environment Configuration

# API Keys for Data Sources
REACT_APP_WORLDBANK_API_KEY=your_worldbank_api_key_here
REACT_APP_NEWS_API_KEY=your_news_api_key_here
REACT_APP_SECURITY_DB_TOKEN=your_security_database_token_here
REACT_APP_IMF_API_KEY=your_imf_api_key_here

# Security Configuration
REACT_APP_CLASSIFICATION_LEVEL=TOP_SECRET
REACT_APP_ENABLE_AUDIT_LOG=true

# Feature Flags
REACT_APP_ENABLE_SCENARIO_ANALYSIS=true
REACT_APP_ENABLE_REAL_TIME_ALERTS=true
REACT_APP_ENABLE_EXPORT_FEATURES=true

# Data Refresh Intervals (in milliseconds)
REACT_APP_DATA_REFRESH_INTERVAL=300000
REACT_APP_ALERT_CHECK_INTERVAL=60000

# Map Configuration
REACT_APP_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
REACT_APP_DEFAULT_MAP_ZOOM=2
REACT_APP_DEFAULT_LATITUDE=20
REACT_APP_DEFAULT_LONGITUDE=0

# Export Configuration
REACT_APP_PDF_REPORT_TEMPLATE=government_template
REACT_APP_EXCEL_EXPORT_FORMAT=xlsx
REACT_APP_MAX_EXPORT_ROWS=10000

# Development Settings
REACT_APP_API_BASE_URL=http://localhost:3001/api
REACT_APP_DEBUG_MODE=true